      "callouts": [
        {
          "type": "tip",
          "text_md": "**How much** es para precios. Para cantidades contables (¿cuántos?), usamos **How many**. En esta lección, solo necesitas **How much**."
        },
        {
          "type": "common_error",
          "text_md": "No digas **How much is the price?** Es redundante. Solo di **How much is it?** o **How much is this shirt?**"
        }
      ],
      "common_errors_es": [
        "Decir 'How much cost?' en lugar de 'How much is it?' — el verbo 'cost' no se usa con 'how much' en esta estructura.",
        "Olvidar el verbo 'be': 'How much this shirt?' en lugar de 'How much is this shirt?'.",
        "Usar 'How many' para precios: 'How many is it?' es incorrecto; siempre es 'How much is it?'."
      ]
    }
  ],
