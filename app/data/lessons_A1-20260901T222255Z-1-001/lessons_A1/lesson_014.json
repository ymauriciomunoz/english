  "grammar_explanations": [
    {
      "slug": "present simple: be (it is + time)",
      "title_form": "El verbo ser/estar con la hora",
      "title_target": "The verb to be with time",
      "description_md_form": "Para decir la hora en inglés, usamos **it is** (es/está) + la hora. Es una forma fija: **it** no cambia, siempre es singular. Para decir \"en punto\" usamos **o'clock** y para \"y media\" usamos **half past**. Ejemplos: **It is one o'clock** (Es la una en punto) y **It is half past eight** (Son las ocho y media). Para preguntar la hora, usamos la pregunta fija **What time is it?** (¿Qué hora es?). Esta estructura es muy simple: no cambia con la persona, solo con la hora.",
      "description_md_target": "To tell the time in English, we use **it is** + the time. It is a fixed form: **it** never changes, it is always singular. To say \"o'clock\" we use **o'clock** and for \"half past\" we use **half past**. Examples: **It is one o'clock** and **It is half past eight**. To ask the time, we use the fixed question **What time is it?**. This structure is very simple: it does not change with the person, only with the time.",
      "grammar_structure": "It is + [hour] + o'clock / half past + [hour]",
      "conjugation_table": {
        "name": "present_simple_be_time",
        "headers": [
          "Expresión",
          "Uso",
          "Ejemplo"
        ],
        "rows": [
