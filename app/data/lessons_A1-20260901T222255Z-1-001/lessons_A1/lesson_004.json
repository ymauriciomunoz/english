      "callouts": [
        {
          "type": "common_error",
          "text_md": "**No digas** *I have seven years*. En inglés, la edad se expresa con **to be**, no con *to have*. Usa **I am seven years old**."
        },
        {
          "type": "tip",
          "text_md": "**Recuerda**: *years old* es opcional en conversación. Puedes decir *I am seven* y es correcto, pero *I am seven years old* es más completo."
        }
      ],
      "common_errors_es": [
        "Usar *have* en lugar de *be*: *I have seven years* en vez de *I am seven years old*.",
        "Olvidar el cambio de forma: *I is seven* en vez de *I am seven*.",
        "Omitir *years old*: *I am seven* en vez de *I am seven years old*."
      ]
    }
  ],
