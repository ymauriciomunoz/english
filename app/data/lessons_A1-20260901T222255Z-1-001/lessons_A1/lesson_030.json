  "grammar_explanations": [
    {
      "slug": "present simple: questions (What time is ...?)",
      "title_form": "Preguntas con What time is...?",
      "title_target": "Questions with What time is...?",
      "description_md_form": "Para preguntar por la hora de algo, usamos **What time is...?** (¿A qué hora es...?). Es una pregunta muy común en hoteles y en la vida diaria.\n\nLa estructura es simple:\n\n- **What time is** + sustantivo + **?**\n\nEjemplos:\n\n- `What time is breakfast?` = ¿A qué hora es el desayuno?\n- `What time is the reservation?` = ¿A qué hora es la reserva?\n\nSolo cambia el sustantivo al final. No necesitas conjugar el verbo. Esta pregunta es fija y se usa igual para todo.",
      "description_md_target": "To ask about the time of something, we use **What time is...?**. It is a very common question in hotels and daily life.\n\nThe structure is simple:\n\n- **What time is** + noun + **?**\n\nExamples:\n\n- `What time is breakfast?`\n- `What time is the reservation?`\n\nYou only change the noun at the end. You do not need to conjugate the verb. This question is fixed and used the same way for everything.",
      "grammar_structure": "What time is + [noun] + ?",
      "conjugation_table": null,
      "examples": [
        {
          "id": "exm_gex_001",
          "lexeme_id": null,
          "chunk_id": "chunk_what_time_is_breakfast",
          "grammar_slug": null,
