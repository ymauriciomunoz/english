  "grammar_explanations": [
    {
      "slug": "plural nouns: regular and irregular (foot/feet, tooth/teeth)",
      "title_form": "Plurales regulares e irregulares",
      "title_target": "Regular and Irregular Plurals",
      "description_md_form": "En inglés, para hablar de **más de una** parte del cuerpo, usamos el **plural**. La forma más común es agregar **-s** al final: *hand* → *hands*, *eye* → *eyes*. Pero hay **plurales irregulares** que cambian la palabra por completo. Dos muy importantes son: *foot* → **feet** y *tooth* → **teeth**. No decimos *foots* ni *tooths*. Con los plurales usamos **these are** (estos son) y con el singular usamos **this is** (este es). Por ejemplo: *This is my foot* (singular) y *These are my feet* (plural).",
      "description_md_target": "In English, to talk about **more than one** body part, we use the **plural**. The most common way is to add **-s** at the end: *hand* → *hands*, *eye* → *eyes*. But there are **irregular plurals** that change the word completely. Two very important ones are: *foot* → **feet** and *tooth* → **teeth**. We don't say *foots* or *tooths*. With plurals we use **these are** (these are) and with singular we use **this is** (this is). For example: *This is my foot* (singular) and *These are my feet* (plural).",
      "grammar_structure": "This is + singular noun / These are + plural noun",
      "conjugation_table": {
        "name": "plural_nouns",
        "headers": [
          "Singular",
          "Plural",
          "Regla"
        ],
        "rows": [
          [
            "hand",
            "hands",
            "Agregar -s"
          ],
          [
