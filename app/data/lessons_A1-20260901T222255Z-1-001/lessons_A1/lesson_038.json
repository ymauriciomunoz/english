      "callouts": [
        {
          "type": "warning",
          "text_md": "**¡Cuidado!** *Foot* y *tooth* son irregulares. No digas *foots* ni *tooths*. La forma correcta es **feet** y **teeth**."
        },
        {
          "type": "tip",
          "text_md": "**Tip:** Usa **this is** para una sola cosa (*this is my hand*) y **these are** para varias (*these are my hands*)."
        }
      ],
      "common_errors_es": [
        "Decir 'foots' en lugar de 'feet'.",
        "Decir 'tooths' en lugar de 'teeth'.",
        "Usar 'this is' con plural: 'this is my hands' en vez de 'these are my hands'."
      ]
    }
  ],
