      "callouts": [
        {
          "type": "tip",
          "text_md": "**Recuerda:** con *doesn't*, el verbo va sin -s. *She doesn't know*, no *She doesn't knows*."
        },
        {
          "type": "common_error",
          "text_md": "**Error común:** *I no like* → correcto: *I don't like*. En inglés, la negación siempre lleva *don't* o *doesn't*."
        }
      ],
      "common_errors_es": [
        "Decir *I no like* en lugar de *I don't like*.",
        "Usar *doesn't* con *I*: *I doesn't want* → correcto: *I don't want*.",
        "Añadir -s al verbo después de *doesn't*: *She doesn't knows* → correcto: *She doesn't know*."
      ]
    }
  ],
