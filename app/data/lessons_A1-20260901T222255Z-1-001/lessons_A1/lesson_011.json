      "callouts": [
        {
          "type": "tip",
          "text_md": "**Recuerda:** con *he, she, it* usamos **does**, no *do*. El verbo después de does va sin -s: *Does she have...?* (no *has*)."
        },
        {
          "type": "common_error",
          "text_md": "**Error común:** *Does he has a dog?* → **Incorrecto**. Después de *does*, el verbo va en forma base: *Does he have a dog?*"
        },
        {
          "type": "warning",
          "text_md": "**Ojo:** la respuesta corta usa *do/does*, no repite el verbo. No digas *Yes, I use.* → di *Yes, I do.*"
        }
      ],
      "common_errors_es": [
        "Usar 'do' con he/she/it: *Do she like milk?* → **Does she like milk?**",
        "Poner -s al verbo después de does: *Does he answers?* → **Does he answer?**",
        "Responder repitiendo el verbo: *Yes, I use.* → **Yes, I do.**",
        "Olvidar el auxiliar en la pregunta: *You have a dog?* → **Do you have a dog?**"
      ]
    }
  ],
