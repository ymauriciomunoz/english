  "grammar_explanations": [
    {
      "slug": "present simple: review (affirmative, negative, questions)",
      "title_form": "Presente simple: repaso (afirmativo, negativo, preguntas)",
      "title_target": "Present Simple: Review (Affirmative, Negative, Questions)",
      "description_md_form": "El **presente simple** describe rutinas y hábitos. Para la mayoría de los verbos, la forma es la misma para todas las personas, **excepto** con *he*, *she* e *it*, donde añadimos una **-s** al verbo.\n\n- **Afirmativo:** `I get up at seven.`\n- **Negativo:** usamos **don't** (I, you, we, they) o **doesn't** (he, she, it) + el verbo en su forma base. `She doesn't work.`\n- **Preguntas:** usamos **Do** o **Does** al inicio + el verbo en su forma base. `Do you study?`\n\nRecuerda: en negativo y en preguntas, el verbo **no** lleva -s.",
      "description_md_target": "The **present simple** describes routines and habits. For most verbs, the form is the same for all persons, **except** with *he*, *she* and *it*, where we add an **-s** to the verb.\n\n- **Affirmative:** `I get up at seven.`\n- **Negative:** we use **don't** (I, you, we, they) or **doesn't** (he, she, it) + the base form of the verb. `She doesn't work.`\n- **Questions:** we use **Do** or **Does** at the beginning + the base form of the verb. `Do you study?`\n\nRemember: in negatives and questions, the verb **does not** take -s.",
      "grammar_structure": "Affirmative: Subject + verb (+s for he/she/it) + complement. Negative: Subject + don't/doesn't + base verb + complement. Question: Do/Does + subject + base verb + complement?",
      "conjugation_table": {
        "name": "present_simple_routines",
        "headers": [
          "Pronombre",
          "Afirmativo",
          "Negativo",
          "Pregunta"
        ],
        "rows": [
          [
            "I",
            "get up",
            "don't get up",
            "Do I get up?"
          ],
          [
            "You",
            "get up",
            "don't get up",
            "Do you get up?"
          ],
          [
            "He/She/It",
            "gets up",
            "doesn't get up",
            "Does she get up?"
          ],
          [
            "We",
            "get up",
            "don't get up",
            "Do we get up?"
          ],
          [
            "They",
            "get up",
            "don't get up",
            "Do they get up?"
          ]
        ]
      },
