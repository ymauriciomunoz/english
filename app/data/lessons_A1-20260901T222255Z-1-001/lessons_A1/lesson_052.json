      "callouts": [
        {
          "type": "tip",
          "text_md": "**Pista:** en preguntas y negativos, el verbo principal vuelve a su forma base. No digas *Does she works?* — di *Does she work?*"
        },
        {
          "type": "common_error",
          "text_md": "**Error común:** olvidar la -s en la tercera persona del afirmativo. *He get up* es incorrecto; lo correcto es *He gets up*."
        }
      ],
      "common_errors_es": [
        "Olvidar la -s en la tercera persona del singular en afirmativo: *She work* → *She works*.",
        "Usar -s en el verbo después de *does* o *doesn't*: *He doesn't works* → *He doesn't work*.",
        "Olvidar *do/does* en las preguntas: *You study?* → *Do you study?*"
      ]
    }
  ],
