      "callouts": [
        {
          "type": "tip",
          "text_md": "**Tip:** En inglés hablado, *have got* es más natural que *have* para hablar de la familia. Usa *I have got* para presentar a tu familia."
        },
        {
          "type": "common_error",
          "text_md": "**Error común:** No digas *I have got a mother and a father* con *have* solo. La forma correcta es *I have got*."
        }
      ],
      "common_errors_es": [
        "Olvidar el artículo *a* antes del miembro de la familia: *I have got brother* (incorrecto) → *I have got a brother* (correcto).",
        "Olvidar el artículo *a* antes del miembro de la familia: *I have got brother* (incorrecto) → *I have got a brother* (correcto).",
        "Confundir *have got* con *has got*: con *I*, *you*, *we*, *they* usamos *have got*; con *he*, *she*, *it* usamos *has got*."
      ]
    }
  ],
