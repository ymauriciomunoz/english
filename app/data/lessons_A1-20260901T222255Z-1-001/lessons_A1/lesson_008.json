  "grammar_explanations": [
    {
      "slug": "have got: affirmative (I have got ...)",
      "title_form": "Have got: afirmativo (Yo tengo ...)",
      "title_target": "Have got: affirmative (I have got ...)",
      "description_md_form": "Usamos **have got** para hablar de lo que tenemos, como nuestra **familia**. Es muy común en inglés hablado.\n\nLa estructura es simple:\n\n- **I have got** + familia\n\nEjemplos:\n\n- **I have got** a mother.\n- **I have got** a brother and a sister.\n\n**Importante:** *have got* significa *tener*. No lo confundas con *have* (que también significa *tener*). En esta lección, usamos *have got* para presentar a nuestra familia.\n\nRecuerda: *have got* es una forma fija. No decimos *I have got a mother and a father* de otra manera.",
      "description_md_target": "We use **have got** to talk about what we have, like our **family**. It is very common in spoken English.\n\nThe structure is simple:\n\n- **I have got** + family\n\nExamples:\n\n- **I have got** a mother.\n- **I have got** a brother and a sister.\n\n**Important:** *have got* means *to have*. Do not confuse it with *have* (which also means *to have*). In this lesson, we use *have got* to introduce our family.\n\nRemember: *have got* is a fixed form. We do not say *I have got a mother and a father* in another way.",
      "grammar_structure": "I + have got + (a/an) + family member",
      "conjugation_table": {
        "name": "have_got_affirmative",
        "headers": [
          "Pronombre",
          "Forma",
          "Ejemplo"
        ],
        "rows": [
          [
            "I",
            "have got",
            "I have got a sister."
          ],
          [
            "You",
            "have got",
            "You have got a brother."
          ],
          [
            "He",
            "has got",
            "He has got a son."
          ],
          [
            "She",
            "has got",
            "She has got a daughter."
          ],
          [
            "We",
            "have got",
            "We have got a family."
          ],
          [
            "They",
            "have got",
            "They have got parents."
          ]
        ]
      },
