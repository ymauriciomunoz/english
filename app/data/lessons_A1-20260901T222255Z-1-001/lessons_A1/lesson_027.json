      "callouts": [
        {
          "type": "tip",
          "text_md": "**Where's** es la forma corta de **Where is**. Es muy común en conversación: *Where's the hotel?*"
        },
        {
          "type": "common_error",
          "text_md": "No digas *Where is the bank?* con el verbo al final. En inglés, el verbo **is** va después de **Where**, no al final."
        }
      ],
      "common_errors_es": [
        "Decir *Where the bank is?* en lugar de *Where is the bank?*",
        "Olvidar el artículo **the** antes del lugar: *Where is bank?* en lugar de *Where is the bank?*",
        "Usar *is* con plurales: *Where is the shops?* en lugar de *Where are the shops?*"
      ]
    }
  ],
