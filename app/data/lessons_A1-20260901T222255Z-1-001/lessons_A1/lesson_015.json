      "callouts": [
        {
          "type": "tip",
          "text_md": "**Piensa en ON como 'encima' de un día.** Si puedes poner el día en un calendario, usa `on`: `on Friday`, `on Sunday`."
        },
        {
          "type": "warning",
          "text_md": "**Cuidado con `today`, `tomorrow` y `yesterday`.** No usan preposición. Decimos `today`, no `on today`."
        },
        {
          "type": "common_error",
          "text_md": "**No digas `in Monday`.** Para días de la semana, la preposición correcta es **`on`**: `on Monday`, `on the weekend`."
        }
      ],
      "common_errors_es": [
        "Decir 'in Monday' en lugar de 'on Monday'. Para días, siempre usamos 'on'.",
        "Decir 'on the morning' en lugar de 'in the morning'. Para partes del día, usamos 'in'.",
        "Usar preposición con 'today', 'tomorrow' o 'yesterday'. Estas palabras no llevan preposición."
      ]
    }
