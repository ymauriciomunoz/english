  "course_id": "en.A1",
  "title_form": "Contar del 21 al 100",
  "title_target": "Counting from 21 to 100",
  "theme_focus": "Números del 21 al 100: repaso de twenty y de las unidades, introducción de las decenas y composición de números compuestos (twenty-one, thirty-two, fifty-five). La generación de contenido debe modelar la composición con guion y practicarla en ejemplos, ejercicios y quiz.",
  "learning_objectives": [
    "Can count from 21 to 100 using reviewed ones/twenty and new tens, form compound numbers like fifty-five, and state ages using numbers."
  ],
  "estimated_minutes": 30,
  "prerequisites": [
    "lesson_005"
  ],
