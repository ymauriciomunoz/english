      "callouts": [
        {
          "type": "tip",
          "text_md": "**Tip:** En preguntas, usa **any**. Pero si ofreces algo, puedes usar **some**: `Do you want some tea?`"
        },
        {
          "type": "common_error",
          "text_md": "**Error común:** No digas `Do you have some coffee?` en una pregunta normal. Usa **any**."
        },
        {
          "type": "warning",
          "text_md": "**Ojo:** **Much** es para incontables (sugar, water) y **many** para contables (cups, bottles)."
        }
      ],
      "common_errors_es": [
        "Usar 'some' en preguntas: 'Do you have some coffee?' → correcto: 'Do you have any coffee?'",
        "Usar 'any' en afirmativas: 'I want any water.' → correcto: 'I want some water.'",
        "Confundir 'much' y 'many': 'How many sugar?' → correcto: 'How much sugar?'"
