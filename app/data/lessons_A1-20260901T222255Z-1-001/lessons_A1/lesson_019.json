  "grammar_explanations": [
    {
      "slug": "prepositions: by + transport",
      "title_form": "Preposición \"by\" con medios de transporte",
      "title_target": "Preposition \"by\" with transport",
      "description_md_form": "En inglés, para decir **cómo** viajas, usamos la preposición **by** + el medio de transporte, **sin artículo** (sin \"a\", \"an\" o \"the\").\n\n- **by car** = en coche\n- **by bus** = en autobús\n- **by train** = en tren\n- **by taxi** = en taxi\n- **by bicycle** = en bicicleta\n\nEjemplo: *I go to work **by bus**.* = Voy al trabajo en autobús.\n\n**Importante:** No decimos \"by the bus\" ni \"by a car\". La estructura es siempre **by + transporte**.",
      "description_md_target": "In English, to say **how** you travel, we use the preposition **by** + the means of transport, **without an article** (without \"a\", \"an\" or \"the\").\n\n- **by car**\n- **by bus**\n- **by train**\n- **by taxi**\n- **by bicycle**\n\nExample: *I go to work **by bus**.*\n\n**Important:** We do not say \"by the bus\" or \"by a car\". The structure is always **by + transport**.",
      "grammar_structure": "Subject + verb + by + transport",
      "conjugation_table": {
        "name": "by + transport",
        "headers": [
          "Transporte",
          "Ejemplo"
        ],
        "rows": [
          [
            "by car",
            "I go to work by car."
          ],
          [
            "by bus",
            "She goes to school by bus."
          ],
          [
