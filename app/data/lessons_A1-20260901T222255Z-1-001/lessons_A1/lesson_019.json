      "callouts": [
        {
          "type": "common_error",
          "text_md": "**No uses artículo después de \"by\"**: decimos *by bus*, *by car*, *by train*. Nunca *by the bus* ni *by a car*."
        },
        {
          "type": "tip",
          "text_md": "**Excepción**: con \"on foot\" (a pie) no usamos \"by\". Decimos *I go to work on foot*, no *by foot*."
        }
      ],
      "common_errors_es": [
        "Decir \"by the bus\" en lugar de \"by bus\" (sin artículo).",
        "Usar \"in\" en lugar de \"by\" para medios de transporte: *I go by car* (no *I go in car*).",
        "Olvidar que \"by bicycle\" y \"by bike\" son correctos, pero \"by foot\" no lo es (se dice \"on foot\")."
      ]
    }
  ],
