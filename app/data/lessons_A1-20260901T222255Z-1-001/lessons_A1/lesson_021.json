      "callouts": [
        {
          "type": "common_error",
          "text_md": "**No digas** `a water` o `a coffee`. `Water`, `coffee`, `tea` y `juice` son incontables. Solo usamos `a`/`an` con comida contable como `a salad`, `an apple`, `a cake`."
        },
        {
          "type": "tip",
          "text_md": "**Recuerda:** `an` se usa con vocales. `An apple`, `an egg`. Pero `a` con consonantes: `a salad`, `a chicken`, `a cake`."
        }
      ],
      "common_errors_es": [
        "Decir 'a water' en vez de 'water'. Las bebidas no llevan artículo.",
        "Decir 'a apple' en vez de 'an apple'. Antes de vocal usamos 'an'.",
        "Olvidar el artículo: 'I want salad' en vez de 'I want a salad'."
      ]
    }
  ],
