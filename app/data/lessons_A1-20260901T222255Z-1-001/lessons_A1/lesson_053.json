  "grammar_explanations": [
    {
      "slug": "present simple: review (affirmative, negative, questions)",
      "title_form": "Presente simple: repaso (afirmativo, negativo, preguntas)",
      "title_target": "Present Simple: Review (Affirmative, Negative, Questions)",
      "description_md_form": "Repasamos el **presente simple** para hablar de rutinas y tiempo libre. Lo usamos con adverbios como `usually`, `often`, `sometimes` y `never`.\n\n**Afirmativo:** `I get up early.`\n**Negativo:** `I don't play football.` (usamos `don't` con I, you, we, they)\n**Preguntas:** `Do you cook dinner?` (empezamos con `Do` y la respuesta corta es `Yes, I do.` / `No, I don't.`)\n\nRecuerda: con **he, she, it** añadimos **-s** al verbo: `She plays tennis.`",
      "description_md_target": "We review the **present simple** to talk about routines and free time. We use it with adverbs like `usually`, `often`, `sometimes` and `never`.\n\n**Affirmative:** `I get up early.`\n**Negative:** `I don't play football.` (we use `don't` with I, you, we, they)\n**Questions:** `Do you cook dinner?` (we start with `Do` and the short answer is `Yes, I do.` / `No, I don't.`)\n\nRemember: with **he, she, it** we add **-s** to the verb: `She plays tennis.`",
      "grammar_structure": "Subject + verb (+ -s for he/she/it) | Subject + don't + verb | Do + subject + verb?",
      "conjugation_table": {
        "name": "present_simple",
        "headers": [
          "Pronombre",
          "Afirmativo",
          "Negativo",
          "Pregunta"
        ],
        "rows": [
          [
            "I",
            "I get up",
            "I don't get up",
            "Do I get up?"
          ],
          [
            "You",
            "You play",
            "You don't play",
            "Do you play?"
          ],
          [
            "He/She/It",
            "She plays",
            "She doesn't play",
            "Does she play?"
          ],
          [
            "We",
            "We cook",
            "We don't cook",
            "Do we cook?"
          ],
          [
            "They",
            "They watch",
            "They don't watch",
            "Do they watch?"
          ]
        ]
      },
