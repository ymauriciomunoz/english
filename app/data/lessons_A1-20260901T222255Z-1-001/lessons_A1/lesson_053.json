      "callouts": [
        {
          "type": "tip",
          "text_md": "**Orden de las palabras:** en las preguntas, el orden es `Do` + sujeto + verbo. No digas `You do play?` — di `Do you play?`"
        },
        {
          "type": "common_error",
          "text_md": "**No olvides la -s con he/she/it.** Decimos `She plays`, no `She play`. Es un error muy común."
        },
        {
          "type": "warning",
          "text_md": "**`don't` vs `doesn't`:** usamos `don't` con I, you, we, they. Usamos `doesn't` con he, she, it. Ejemplo: `He doesn't cook dinner.`"
        }
      ],
      "common_errors_es": [
        "Olvidar la -s en la tercera persona: `She play tennis` (correcto: `She plays tennis`).",
        "Usar `don't` con he/she/it: `He don't like coffee` (correcto: `He doesn't like coffee`).",
        "Olvidar `Do` al inicio de la pregunta: `You play football?` (correcto: `Do you play football?`).",
        "Poner el adverbio en el lugar equivocado: `I get up usually early` (correcto: `I usually get up early`)."
      ]
    }
  ],
