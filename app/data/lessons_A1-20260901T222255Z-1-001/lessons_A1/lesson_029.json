      "callouts": [
        {
          "type": "tip",
          "text_md": "**Tip:** Usa `then` para conectar dos instrucciones. Es como \"luego\" en español: `Go straight, then turn left.`"
        },
        {
          "type": "common_error",
          "text_md": "**Error común:** No digas `You go straight.` para dar direcciones. El imperativo no usa sujeto: `Go straight.`"
        }
      ],
      "common_errors_es": [
        "Decir 'You go straight' en lugar de 'Go straight' (el imperativo no lleva sujeto).",
        "Olvidar 'then' para conectar pasos: 'Go straight, turn left' suena incompleto; usa 'then'.",
        "Confundir 'turn left' con 'turn to the left' (la forma natural es sin 'to the')."
      ]
    }
  ],
