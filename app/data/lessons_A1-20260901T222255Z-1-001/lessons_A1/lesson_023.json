  "grammar_explanations": [
    {
      "slug": "wh-questions: how much with be",
      "title_form": "Preguntas con How much y el verbo to be",
      "title_target": "Questions with How much and the verb to be",
      "description_md_form": "Para preguntar por un **precio**, usamos **How much** + el verbo **to be** + el sujeto. Es la forma más común y natural para preguntar cuánto cuesta algo.\n\n- **How much is** the coffee? = ¿Cuánto cuesta el café?\n- **How much are** the tickets? = ¿Cuánto cuestan los boletos?\n\nUsamos **is** con un solo objeto (singular) y **are** con varios objetos (plural). La respuesta típica es con el verbo **to be** también: *It is five dollars.*",
      "description_md_target": "To ask about a **price**, we use **How much** + the verb **to be** + the subject. It is the most common and natural way to ask how much something costs.\n\n- **How much is** the coffee?\n- **How much are** the tickets?\n\nWe use **is** with one object (singular) and **are** with several objects (plural). The typical answer also uses the verb **to be**: *It is five dollars.*",
      "grammar_structure": "How much + to be (is/are) + subject?",
      "conjugation_table": {
        "name": "how_much_with_be",
        "headers": [
          "Sujeto",
          "Pregunta",
          "Respuesta"
        ],
        "rows": [
          [
            "the coffee (singular)",
            "How much is the coffee?",
            "It is two dollars."
          ],
          [
            "the tickets (plural)",
            "How much are the tickets?",
            "They are ten dollars."
          ],
          [
            "it (singular)",
            "How much is it?",
            "It is five dollars."
          ],
          [
            "they (plural)",
            "How much are they?",
            "They are eight dollars."
          ]
        ]
      },
