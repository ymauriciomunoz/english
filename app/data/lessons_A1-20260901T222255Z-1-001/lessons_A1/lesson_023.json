      "callouts": [
        {
          "type": "tip",
          "text_md": "**How much** es solo para precios o cantidades incontables (agua, tiempo). Para objetos contables, también funciona: *How much is the bread?*"
        },
        {
          "type": "common_error",
          "text_md": "No digas *How much **costs** it?* — con **to be** no usamos **cost**. Decimos: *How much **is** it?*"
        }
      ],
      "common_errors_es": [
        "Decir *How much costs the coffee?* en lugar de *How much is the coffee?*",
        "Usar *How much are it?* en lugar de *How much is it?* (it siempre va con is).",
        "Olvidar el verbo to be: *How much the coffee?* en lugar de *How much is the coffee?*"
      ]
    }
  ],
