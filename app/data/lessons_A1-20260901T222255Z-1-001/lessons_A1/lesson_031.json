      "callouts": [
        {
          "type": "tip",
          "text_md": "**There is** se usa con una cosa. **There are** se usa con varias. No digas `There is two parks` — es un error común."
        },
        {
          "type": "common_error",
          "text_md": "En español decimos 'hay' para todo. En inglés, **there is** (singular) y **there are** (plural) son diferentes. Presta atención al número."
        }
      ],
      "common_errors_es": [
        "Usar 'there is' con plural: ✗ There is two parks. → ✓ There are two parks.",
        "Olvidar 'there' en la pregunta: ✗ Is a cafe near here? → ✓ Is there a cafe near here?",
        "Confundir 'there' con 'their' (su de ellos). 'There' indica lugar o existencia."
      ]
    }
  ],
