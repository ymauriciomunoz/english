  "grammar_explanations": [
    {
      "slug": "imperative: affirmative for requests (Call/Help)",
      "title_form": "Imperativo afirmativo para pedir (Call/Help)",
      "title_target": "Affirmative Imperative for Requests (Call/Help)",
      "description_md_form": "El **imperativo afirmativo** se usa para **pedir** o **ordenar** algo directamente. Es la forma más simple del verbo: **usamos el verbo sin sujeto y sin 'to'**.\n\n- **Call** the doctor. = Llame al doctor.\n- **Help** me, please. = Ayúdeme, por favor.\n\nPara hacer un pedido más **educado**, añadimos **\"please\"** al final o usamos **\"Excuse me\"** al principio.\n\n- **Call** the police, **please**. = Llame a la policía, por favor.\n- **Excuse me**, I need help. = Disculpe, necesito ayuda.\n\nEs la misma forma para **todas las personas** (you, he, she, we, they). No cambia.",
      "description_md_target": "The **affirmative imperative** is used to **ask** or **order** something directly. It is the simplest verb form: **we use the verb without a subject and without 'to'**.\n\n- **Call** the doctor.\n- **Help** me, please.\n\nTo make a more **polite** request, add **\"please\"** at the end or use **\"Excuse me\"** at the beginning.\n\n- **Call** the police, **please**.\n- **Excuse me**, I need help.\n\nIt is the same form for **all persons** (you, he, she, we, they). It does not change.",
      "grammar_structure": "Verb (base form) + object + (please)",
      "conjugation_table": {
        "name": "imperative_affirmative",
        "headers": [
          "Persona",
          "Verbo",
          "Ejemplo"
        ],
        "rows": [
          [
            "you (singular)",
            "call",
            "Call the doctor."
          ],
          [
            "you (plural)",
            "call",
            "Call the police."
          ],
          [
            "you (singular)",
            "help",
            "Help me, please."
          ],
          [
            "you (plural)",
            "help",
            "Help us, please."
          ]
        ]
      },
