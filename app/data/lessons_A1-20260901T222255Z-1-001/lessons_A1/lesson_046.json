      "callouts": [
        {
          "type": "tip",
          "text_md": "**Tip:** Para sonar más educado, siempre añade **\"please\"** al final de la orden: *Call the ambulance, please.*"
        },
        {
          "type": "common_error",
          "text_md": "**Error común:** No digas *\"You call the police\"* para dar una orden. En inglés, el imperativo no lleva sujeto: *Call the police.*"
        }
      ],
      "common_errors_es": [
        "Usar el sujeto 'you' en el imperativo: *You call the doctor* → **Call the doctor**.",
        "Olvidar 'please' para sonar educado: *Help me* → **Help me, please**.",
        "Confundir el imperativo con el presente simple: *He calls the police* (él llama) vs. **Call the police** (¡llame!)."
      ]
    }
  ],
