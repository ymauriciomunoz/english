      "callouts": [
        {
          "type": "tip",
          "text_md": "**Forma corta**: en conversación usamos *It's*, *He's*, *She's* en lugar de *It is*, *He is*, *She is*. Suena más natural."
        },
        {
          "type": "common_error",
          "text_md": "**Cuidado**: el adjetivo en inglés **no tiene plural**. Decimos *The apples are red*, **no** *The apples are reds*."
        }
      ],
      "common_errors_es": [
        "Decir 'The apple is reds' (el adjetivo no lleva plural en inglés).",
        "Olvidar el verbo: 'The apple red' en lugar de 'The apple is red'.",
        "Usar 'have' en lugar de 'be': 'My eyes have blue' en vez de 'My eyes are blue'."
      ]
    }
