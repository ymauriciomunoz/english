      "callouts": [
        {
          "type": "tip",
          "text_md": "**Recuerda**: *there is* para **un** objeto y *there are* para **varios**. Mira el sustantivo que sigue para elegir la forma correcta."
        },
        {
          "type": "common_error",
          "text_md": "**Error común**: No digas *there is two books*. Como *books* es plural, necesitas *there are*."
        }
      ],
      "common_errors_es": [
        "Usar *there is* con sustantivos plurales: *There is two books* → **There are two books**.",
        "Olvidar el artículo *a/an* antes del sustantivo singular: *There is cat* → **There is a cat**.",
        "Poner la preposición antes del objeto: *Under the table there is a cat* → **There is a cat under the table**."
      ]
    }
  ],
