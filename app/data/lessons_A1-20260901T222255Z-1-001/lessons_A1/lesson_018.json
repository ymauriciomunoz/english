      "callouts": [
        {
          "type": "tip",
          "text_md": "**Posición del adverbio:** con verbos normales, el adverbio va **antes** del verbo: `I always read.` Con el verbo **to be**, va **después**: `I am always happy.`"
        },
        {
          "type": "common_error",
          "text_md": "**Error común:** no digas `I drink always coffee`. El adverbio va antes del verbo, no después: `I always drink coffee.`"
        }
      ],
      "common_errors_es": [
        "Colocar el adverbio después del verbo: ✗ `I drink always coffee` → ✓ `I always drink coffee`.",
        "Olvidar que con el verbo to be el adverbio va después: ✗ `I always am happy` → ✓ `I am always happy`.",
        "Usar 'never' con verbo en negativo: ✗ `I never don't study` → ✓ `I never study`."
      ]
    }
  ],
