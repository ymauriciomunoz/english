  "grammar_explanations": [
    {
      "slug": "present simple: questions with do/does (Do you have ...?)",
      "title_form": "Preguntas con Do you have ...?",
      "title_target": "Questions with Do you have ...?",
      "description_md_form": "Para preguntar si alguien tiene algo, usamos **Do you have ...?** Esta estructura es muy útil en una tienda.\n\n**La fórmula es simple:**\n\n`Do you have + [artículo] + [objeto]?`\n\n**Ejemplos:**\n- `Do you have a camera?` = ¿Tiene una cámara?\n- `Do you have an umbrella?` = ¿Tiene un paraguas?\n\n**Puntos clave:**\n- Usamos **a** antes de consonante: `a pen`.\n- Usamos **an** antes de vocal: `an umbrella`.\n- La respuesta corta es: `Yes, I do.` o `No, I don't.`\n\n¡Practica esta pregunta en la tienda!",
      "description_md_target": "To ask if someone has something, we use **Do you have ...?** This structure is very useful in a store.\n\n**The formula is simple:**\n\n`Do you have + [article] + [object]?`\n\n**Examples:**\n- `Do you have a camera?`\n- `Do you have an umbrella?`\n\n**Key points:**\n- We use **a** before a consonant: `a pen`.\n- We use **an** before a vowel: `an umbrella`.\n- The short answer is: `Yes, I do.` or `No, I don't.`\n\nPractice this question in the store!",
      "grammar_structure": "Do you have + [a/an] + [object]?",
      "conjugation_table": {
        "name": "present_simple_questions",
        "headers": [
          "Pregunta",
          "Respuesta corta"
        ],
        "rows": [
          [
            "Do you have a phone?",
            "Yes, I do. / No, I don't."
          ],
          [
            "Do you have a laptop?",
            "Yes, I do. / No, I don't."
          ],
          [
            "Do you have an umbrella?",
            "Yes, I do. / No, I don't."
          ]
        ]
      },
