      "callouts": [
        {
          "type": "common_error",
          "text_md": "**No digas** `in the summer`. En inglés, con las estaciones no usamos *the*. Decimos `in summer`."
        },
        {
          "type": "tip",
          "text_md": "**Recuerda:** `in` se usa con estaciones y meses. Para días usamos `on` (ej. `on Monday`), pero eso lo veremos en otra lección."
        }
      ],
      "common_errors_es": [
        "Decir 'in the summer' en lugar de 'in summer'.",
        "Usar 'on' en lugar de 'in' con estaciones: 'on summer' es incorrecto.",
        "Olvidar la preposición: 'We go to the beach summer' es incorrecto."
      ]
    }
