      "callouts": [
        {
          "type": "tip",
          "text_md": "**Tip:** El imperativo negativo siempre usa `Don't` + verbo. No digas `No run` — di `Don't run`."
        },
        {
          "type": "common_error",
          "text_md": "**Error común:** En español decimos \"No corras\" con el verbo conjugado. En inglés, usamos `Don't` + la forma base: `Don't run`."
        }
      ],
      "common_errors_es": [
        "Decir 'No run' en lugar de 'Don't run'.",
        "Olvidar que el imperativo no lleva sujeto: 'You open' es incorrecto; solo 'Open'.",
        "Usar 'Not' en lugar de 'Don't': 'Not run' es incorrecto; 'Don't run' es correcto."
      ]
    }
  ],
