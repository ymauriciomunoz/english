      "callouts": [
        {
          "type": "tip",
          "text_md": "**My name is** y **I am** significan lo mismo al presentarte. Usa el que prefieras: *My name is Anna* o *I am Anna*."
        },
        {
          "type": "common_error",
          "text_md": "En español decimos *me llamo*, pero en inglés NO se dice *I call me*. Usa **My name is** o **I am**."
        },
        {
          "type": "tip",
          "text_md": "**What's your name?** es la forma natural de preguntar el nombre. *What is your name?* es correcto pero más formal."
        }
      ],
      "common_errors_es": [
        "Decir *I name is Anna* en vez de *My name is Anna* (confundir *my* con *I*).",
        "Usar *is* con *I*: *I is Anna* en lugar de *I am Anna*.",
        "Olvidar el verbo: *My name Anna* en lugar de *My name is Anna*."
      ]
    }
  ],
