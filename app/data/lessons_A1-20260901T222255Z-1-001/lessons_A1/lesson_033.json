      "callouts": [
        {
          "type": "tip",
          "text_md": "**Recuerda:** en inglés, las actividades usan **-ing** (swimming, running, singing). No digas *I like swim* — di *I like swimming*."
        },
        {
          "type": "common_error",
          "text_md": "**Cuidado:** no digas *I like the football*. En inglés, no usamos artículo antes del deporte: *I like football*."
        }
      ],
      "common_errors_es": [
        "Decir *I like swim* en vez de *I like swimming* (actividad con -ing).",
        "Decir *I like the football* en vez de *I like football* (sin artículo).",
        "Confundir *I like* (me gusta) con *I am like* (soy como)."
      ]
    }
