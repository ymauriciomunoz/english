      "callouts": [
        {
          "type": "tip",
          "text_md": "**Tip**: El imperativo afirmativo es la forma más amable para dar instrucciones. Agrega `please` para ser aún más cortés: `Have a coffee, please.`"
        },
        {
          "type": "common_error",
          "text_md": "**Error común**: No uses el sujeto `you` en el imperativo. Decimos `Have a nice day!`, no `You have a nice day!`."
        }
      ],
      "common_errors_es": [
        "Decir 'You have a nice day' en lugar de 'Have a nice day' (no se usa el sujeto en el imperativo).",
        "Confundir el imperativo con el presente simple: 'Have a nice day' (imperativo) vs. 'I have a nice day' (presente).",
        "Olvidar que el imperativo es igual para todas las personas: 'Have' sirve para you, we, they, etc."
      ]
    }
