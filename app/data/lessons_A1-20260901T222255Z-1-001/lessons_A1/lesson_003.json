  "grammar_explanations": [
    {
      "slug": "imperative: affirmative (Have a nice day!)",
      "title_form": "El imperativo afirmativo",
      "title_target": "The Affirmative Imperative",
      "description_md_form": "El **imperativo afirmativo** se usa para dar órdenes, hacer sugerencias o expresar buenos deseos. En inglés, es muy simple: **usamos el verbo en su forma base**, sin sujeto. Por ejemplo: `Have a nice day!` (¡Que tengas un buen día!) o `See you later!` (¡Hasta luego!). No cambia con la persona: es igual para *you* (tú/usted/ustedes). Es una forma muy común en **fórmulas de cortesía** y despedidas. Para hacerlo **negativo**, ponemos `don't` antes del verbo: `Don't be late!` (¡No llegues tarde!).",
      "description_md_target": "The **affirmative imperative** is used to give orders, make suggestions, or express good wishes. In English, it is very simple: **we use the base form of the verb**, without a subject. For example: `Have a nice day!` or `See you later!` It does not change with the person: it is the same for *you*. It is very common in **politeness formulas** and goodbyes. To make it **negative**, put `don't` before the verb: `Don't be late!`.",
      "grammar_structure": "Base form of the verb + (complement)",
      "conjugation_table": {
        "name": "imperative_affirmative",
        "headers": [
          "Uso",
          "Ejemplo"
        ],
        "rows": [
          [
            "Orden",
            "Sit down, please."
          ],
          [
            "Sugerencia",
            "Have a coffee."
          ],
          [
            "Buen deseo",
            "Have a nice day!"
          ],
          [
            "Despedida",
            "See you later!"
          ]
        ]
      },
