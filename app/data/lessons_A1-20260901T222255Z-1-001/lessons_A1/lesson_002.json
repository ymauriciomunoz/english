      "callouts": [
        {
          "type": "tip",
          "text_md": "**Tip:** En inglés, **am**, **is** y **are** significan tanto *ser* como *estar*. No necesitas elegir entre los dos verbos como en español."
        },
        {
          "type": "common_error",
          "text_md": "**Error común:** No digas *I am happy* con el verbo *to be* en forma completa en conversación. Usa la forma corta: **I'm happy**."
        }
      ],
      "common_errors_es": [
        "Decir 'I is happy' en lugar de 'I am happy'. El verbo 'to be' cambia con cada persona.",
        "Olvidar el verbo 'to be' y decir 'I happy' en lugar de 'I'm happy'.",
        "Usar 'am' con 'you': 'You am tired' en lugar de 'You are tired'."
      ]
    }
  ],
