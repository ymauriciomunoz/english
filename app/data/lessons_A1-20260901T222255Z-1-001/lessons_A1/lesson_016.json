  "grammar_explanations": [
    {
      "slug": "preposition of time: in + month (in January)",
      "title_form": "La preposición de tiempo: in + mes",
      "title_target": "Preposition of time: in + month",
      "description_md_form": "Para hablar de **en qué mes** ocurre algo, usamos la preposición **in** antes del mes.\n\n- **in January** = en enero\n- **in March** = en marzo\n\nLa estructura es simple: **in + mes**. No usamos artículo (the) ni otra preposición.\n\nEjemplos:\n- *My birthday is **in May**.* = Mi cumpleaños es en mayo.\n- *We start school **in September**.* = Empezamos la escuela en septiembre.\n\n**Importante:** los meses en inglés **siempre** se escriben con mayúscula inicial (January, February...).",
      "description_md_target": "To talk about **in which month** something happens, we use the preposition **in** before the month.\n\n- **in January** = en enero\n- **in March** = en marzo\n\nThe structure is simple: **in + month**. We don't use an article (the) or another preposition.\n\nExamples:\n- *My birthday is **in May**.*\n- *We start school **in September**.*\n\n**Important:** months in English **always** start with a capital letter (January, February...).",
      "grammar_structure": "in + month",
      "conjugation_table": null,
      "examples": [
        {
          "id": "exm_gex_001",
          "lexeme_id": null,
          "chunk_id": null,
