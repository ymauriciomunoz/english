      ],
      "callouts": [
        {
          "type": "common_error",
          "text_md": "**No digas \"in the January\"** — en inglés no usamos artículo antes del mes. Solo decimos **in January**."
        },
        {
          "type": "tip",
          "text_md": "**Mayúscula siempre:** los meses se escriben con mayúscula inicial en inglés, aunque estén en medio de la oración."
        }
      ],
      "common_errors_es": [
        "Decir \"in the January\" en lugar de \"in January\" (no se usa artículo).",
        "Escribir los meses con minúscula (january) en lugar de mayúscula (January).",
        "Usar \"on\" en lugar de \"in\" con meses (on January es incorrecto)."
      ]
    }
  ],
