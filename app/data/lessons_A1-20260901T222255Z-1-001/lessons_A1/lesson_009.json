  "grammar_explanations": [
    {
      "slug": "have got: questions (Have you got ...?)",
      "title_form": "Preguntas con have got",
      "title_target": "Questions with have got",
      "description_md_form": "Para preguntar si alguien tiene algo, usamos **have got** al inicio de la pregunta. La estructura es: **Have** + sujeto + **got** + objeto.\n\n- **Have you got** a brother? = ¿Tienes un hermano?\n- **Has she got** children? = ¿Ella tiene hijos?\n\nLa respuesta corta es:\n- Yes, I **have**. / No, I **haven't**.\n- Yes, she **has**. / No, she **hasn't**.\n\nRecuerda: **have** con I, you, we, they; **has** con he, she, it.",
      "description_md_target": "To ask if someone has something, we use **have got** at the start of the question. The structure is: **Have** + subject + **got** + object.\n\n- **Have you got** a brother?\n- **Has she got** children?\n\nThe short answers are:\n- Yes, I **have**. / No, I **haven't**.\n- Yes, she **has**. / No, she **hasn't**.\n\nRemember: **have** with I, you, we, they; **has** with he, she, it.",
      "grammar_structure": "Have/Has + subject + got + object?",
      "conjugation_table": {
        "name": "have_got_questions",
        "headers": [
          "Pronombre",
          "Pregunta",
          "Respuesta corta sí",
          "Respuesta corta no"
        ],
        "rows": [
          [
            "I",
            "Have I got ...?",
            "Yes, I have.",
            "No, I haven't."
          ],
          [
            "you",
            "Have you got ...?",
            "Yes, you have.",
            "No, you haven't."
          ],
          [
            "he/she/it",
            "Has he/she/it got ...?",
            "Yes, he/she/it has.",
            "No, he/she/it hasn't."
          ],
          [
            "we",
            "Have we got ...?",
            "Yes, we have.",
            "No, we haven't."
          ],
          [
            "they",
            "Have they got ...?",
            "Yes, they have.",
            "No, they haven't."
          ]
        ]
      },
      "examples": [
        {
