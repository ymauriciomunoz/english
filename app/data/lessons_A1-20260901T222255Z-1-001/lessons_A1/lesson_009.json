      "callouts": [
        {
          "type": "tip",
          "text_md": "**Tip**: En inglés británico, *have got* es muy común para preguntar. En inglés americano, a veces usan solo *do you have*."
        },
        {
          "type": "common_error",
          "text_md": "**Error común**: No digas *Do you have got?*. La forma correcta es *Have you got?*."
        }
      ],
      "common_errors_es": [
        "Decir 'Do you have got a brother?' en lugar de 'Have you got a brother?'.",
        "Olvidar cambiar 'have' por 'has' con he, she, it: 'Has she got children?' no 'Have she got children?'.",
        "Responder 'Yes, I have got' en lugar de la respuesta corta 'Yes, I have'."
      ]
    }
  ],
