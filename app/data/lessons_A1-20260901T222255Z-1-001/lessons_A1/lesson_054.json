      "callouts": [
        {
          "type": "tip",
          "text_md": "**There is** se usa con singular (una cosa) y **There are** con plural (varias cosas). Ejemplo: `There is a menu` vs. `There are two menus`."
        },
        {
          "type": "common_error",
          "text_md": "En preguntas, el orden cambia: **Is there...?** no **There is...?**. Ejemplo: `Is there a restaurant?` (correcto) vs. `There is a restaurant?` (incorrecto)."
        }
      ],
      "common_errors_es": [
        "Decir 'There is two shops' en lugar de 'There are two shops' (confundir singular y plural).",
        "Olvidar el orden de la pregunta: 'There is a menu?' en vez de 'Is there a menu?'.",
        "Usar 'turn to left' en lugar de 'turn left' (el adverbio no lleva 'to')."
      ]
    }
  ],
