  "grammar_explanations": [
    {
      "slug": "present simple: yes/no questions with do/does",
      "title_form": "Preguntas de sí/no con do",
      "title_target": "Yes/No Questions with Do",
      "description_md_form": "Para preguntar sobre gustos usamos **do** al inicio de la pregunta. La estructura es: **Do + sujeto + like + objeto?**\n\n- **Do you like sports?** = ¿Te gustan los deportes?\n- **Do you like films?** = ¿Te gustan las películas?\n\nPara responder, usamos respuestas cortas:\n\n- **Yes, I do.** = Sí, me gustan.\n- **No, I don't.** = No, no me gustan.\n\n**Importante:** En estas preguntas, el verbo *like* no cambia. No decimos *Do you likes?* El verbo queda en su forma base.",
      "description_md_target": "To ask about likes, we use **do** at the start of the question. The structure is: **Do + subject + like + object?**\n\n- **Do you like sports?**\n- **Do you like films?**\n\nFor answers, we use short answers:\n\n- **Yes, I do.**\n- **No, I don't.**\n\n**Important:** In these questions, the verb *like* does not change. We don't say *Do you likes?* The verb stays in its base form.",
      "grammar_structure": "Do + subject + like + object? → Yes, I do. / No, I don't.",
      "conjugation_table": {
        "name": "present_simple_questions",
        "headers": [
          "Pregunta",
          "Respuesta afirmativa",
          "Respuesta negativa"
        ],
        "rows": [
          [
            "Do you like sports?",
            "Yes, I do.",
            "No, I don't."
          ],
          [
            "Do you like films?",
            "Yes, I do.",
            "No, I don't."
          ],
          [
            "Do you like games?",
            "Yes, I do.",
            "No, I don't."
          ]
        ]
      },
