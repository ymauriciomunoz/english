      "callouts": [
        {
          "type": "tip",
          "text_md": "**Do** es la palabra mágica para preguntar. Solo ponla al inicio: *Do you like movies?*"
        },
        {
          "type": "common_error",
          "text_md": "**No digas *Do you like movies?* con *s* en *like*.** El verbo no cambia en preguntas con *do*."
        }
      ],
      "common_errors_es": [
        "Decir *Do you likes movies?* — el verbo no lleva *s* después de *do*.",
        "Responder *Yes, I like* — la respuesta corta correcta es *Yes, I do*.",
        "Olvidar el *do* al inicio: *You like sports?* — en inglés necesitamos *Do you like sports?*"
      ]
    }
  ],
