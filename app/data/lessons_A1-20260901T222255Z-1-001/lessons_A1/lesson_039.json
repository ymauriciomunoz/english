      "callouts": [
        {
          "type": "common_error",
          "text_md": "**No digas *I am headache*.** En inglés, para síntomas se usa **have**, no **be**. Di **I have a headache**."
        },
        {
          "type": "tip",
          "text_md": "**Recuerda el artículo *a*:** se dice **I have a headache** y **I have a cold**. No lo omitas."
        }
      ],
      "common_errors_es": [
        "Decir *I am headache* en lugar de *I have a headache*.",
        "Olvidar el artículo *a*: *I have headache* (incorrecto) → *I have a headache* (correcto).",
        "Confundir *have* con *feel*: *I have a headache* (tener) vs. *I feel sick* (sentirse)."
      ]
    }
