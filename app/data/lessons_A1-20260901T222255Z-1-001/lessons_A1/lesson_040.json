      "callouts": [
        {
          "type": "tip",
          "text_md": "**Usa la contracción al hablar.** *I'm*, *she's*, *they're* suenan más naturales que *I am*, *she is*, *they are* en conversación."
        },
        {
          "type": "common_error",
          "text_md": "**No digas *I am hungry* siempre.** En español decimos *tengo hambre*, pero en inglés usamos *to be* + adjetivo: *I'm hungry*."
        }
      ],
      "common_errors_es": [
        "Decir *I have hungry* en lugar de *I'm hungry* (calco del español *tengo hambre*).",
        "Olvidar el verbo *to be*: *I hungry* en vez de *I'm hungry*.",
        "Usar *I am* en lugar de la contracción *I'm* en conversación informal, lo que suena poco natural."
      ]
    }
