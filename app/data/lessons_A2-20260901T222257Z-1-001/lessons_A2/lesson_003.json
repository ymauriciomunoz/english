      "callouts": [
        {
          "type": "common_error",
          "text_md": "**No digas:** *Does he works?* — Con **does**, el verbo va en forma base: *Does he work?*"
        },
        {
          "type": "tip",
          "text_md": "**Recuerda:** *Do* se usa con *I, you, we, they*; *Does* se usa con *he, she, it*. ¡Es como el *-s* de la tercera persona, pero al revés!"
        }
      ],
      "common_errors_es": [
        "Agregar -s al verbo después de does: *Does she works?* → correcto: *Does she work?*",
        "Olvidar el auxiliar: *You have an appointment?* → correcto: *Do you have an appointment?*",
        "Usar does con I/you: *Does you have...?* → correcto: *Do you have...?*"
      ]
    }
  ],
