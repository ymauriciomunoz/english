  "grammar_explanations": [
    {
      "slug": "present simple: questions with do/does",
      "title_form": "Preguntas en presente simple con do/does",
      "title_target": "Present simple questions with do/does",
      "description_md_form": "Para hacer preguntas en presente simple, usamos **do** o **does** al inicio de la oración. Usamos **do** con *I, you, we, they* y **does** con *he, she, it*.\n\nLa estructura es: **Do/Does + sujeto + verbo en forma base + ...?**\n\nEjemplos:\n- *Do you have an appointment?* (¿Tienes una cita?)\n- *Does she check her agenda?* (¿Ella revisa su agenda?)\n\n**Importante:** Cuando usamos **does**, el verbo principal NO lleva *-s*. Decimos *Does he work?* y NO *Does he works?*.\n\nPara respuestas cortas, usamos **Yes, I do** / **No, I don't** o **Yes, she does** / **No, she doesn't**.",
      "description_md_target": "To make questions in the present simple, we use **do** or **does** at the beginning of the sentence. We use **do** with *I, you, we, they* and **does** with *he, she, it*.\n\nThe structure is: **Do/Does + subject + base verb + ...?**\n\nExamples:\n- *Do you have an appointment?*\n- *Does she check her agenda?*\n\n**Important:** When we use **does**, the main verb does NOT take *-s*. We say *Does he work?* and NOT *Does he works?*.\n\nFor short answers, we use **Yes, I do** / **No, I don't** or **Yes, she does** / **No, she doesn't**.",
      "grammar_structure": "Do/Does + subject + base verb + ...?",
      "conjugation_table": {
        "name": "present_simple_questions",
        "headers": [
          "Pronombre",
          "Pregunta",
          "Respuesta corta sí",
          "Respuesta corta no"
        ],
        "rows": [
          [
            "I",
            "Do I...?",
            "Yes, I do.",
            "No, I don't."
          ],
          [
            "you",
            "Do you...?",
            "Yes, you do.",
            "No, you don't."
          ],
          [
            "he/she/it",
            "Does he/she/it...?",
            "Yes, he/she/it does.",
            "No, he/she/it doesn't."
          ],
          [
            "we",
            "Do we...?",
            "Yes, we do.",
            "No, we don't."
          ],
          [
            "they",
            "Do they...?",
            "Yes, they do.",
            "No, they don't."
          ]
        ]
      },
