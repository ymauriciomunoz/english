      "callouts": [
        {
          "type": "tip",
          "text_md": "**Pista:** si el sujeto es `he`, `she` o `it`, el verbo lleva `-s`. Si es `I`, `you`, `we` o `they`, no lleva nada. Piensa: *¿quién hace la acción?*"
        },
        {
          "type": "common_error",
          "text_md": "**Error común:** *He put on his coat.* ✗ → **He puts on his coat.** ✓ No olvides la `-s` con `he`, `she` o `it`."
        },
        {
          "type": "warning",
          "text_md": "**Cuidado con `go`:** no es `go-s`, es **goes**. Lo mismo con `do` → `does`. Son irregulares en la escritura."
        }
      ],
      "common_errors_es": [
        "Olvidar la -s: *She wear a belt* ✗ → **She wears a belt** ✓",
        "Usar la -s con otras personas: *I puts on* ✗ → **I put on** ✓",
        "Escribir *goes* como *gos*: la forma correcta es **goes**.",
        "Confundir *wear* (llevar puesto) con *put on* (ponerse): *wear* es estado, *put on* es acción."
      ]
    }
