  "grammar_explanations": [
    {
      "slug": "will: predictions and decisions",
      "title_form": "Will: predicciones y decisiones",
      "title_target": "Will: predictions and decisions",
      "description_md_form": "**Will** se usa para hablar de **decisiones** que tomas en el momento de hablar y para hacer **predicciones** sobre el futuro.\n\n**Decisiones espontáneas** (las tomas ahora):\n- *I will complain about the noise.* → Me quejaré del ruido.\n- *I will repeat the word.* → Repetiré la palabra.\n\n**Predicciones** (lo que crees que pasará):\n- *The noise will be loud.* → El ruido será fuerte.\n- *You will hear the warning.* → Oirás la advertencia.\n\n**Estructura:** `will` + verbo en forma base. **No cambia** con la persona: *I will, you will, he will...*\n\n**Forma negativa:** `will not` (won't).\n- *I won't shout.* → No gritaré.\n\n**Contracción:** `I'll`, `you'll`, `he'll`, etc.",
      "description_md_target": "**Will** is used to talk about **decisions** you make at the moment of speaking and to make **predictions** about the future.\n\n**Spontaneous decisions** (you make them now):\n- *I will complain about the noise.*\n- *I will repeat the word.*\n\n**Predictions** (what you believe will happen):\n- *The noise will be loud.*\n- *You will hear the warning.*\n\n**Structure:** `will` + base form of the verb. **It does not change** with the person: *I will, you will, he will...*\n\n**Negative form:** `will not` (won't).\n- *I won't shout.*\n\n**Contraction:** `I'll`, `you'll`, `he'll`, etc.",
      "grammar_structure": "Subject + will + base verb + complement",
      "conjugation_table": {
        "name": "will_future",
        "headers": [
          "Pronombre",
          "Afirmativo",
          "Negativo",
          "Contracción"
        ],
        "rows": [
          [
            "I",
            "I will hear",
            "I will not hear",
            "I'll hear"
          ],
          [
            "You",
            "You will shout",
            "You will not shout",
            "You'll shout"
          ],
          [
            "He/She/It",
            "He will complain",
            "He will not complain",
            "He'll complain"
          ],
          [
            "We",
            "We will listen",
            "We will not listen",
            "We'll listen"
          ],
          [
            "They",
            "They will repeat",
            "They will not repeat",
            "They'll repeat"
          ]
        ]
      },
