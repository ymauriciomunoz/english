      "callouts": [
        {
          "type": "tip",
          "text_md": "**Tip:** En preguntas y negaciones, el verbo vuelve a su forma base. No digas `Did you offered?` — di `Did you offer?`."
        },
        {
          "type": "common_error",
          "text_md": "**Error común:** No confundas `cheap` (barato) con `cheaply` (de forma barata). `Cheap` es un adjetivo: `This shirt is cheap.`"
        },
        {
          "type": "warning",
          "text_md": "**Ojo:** `Offer` puede ser verbo (ofrecer) o sustantivo (oferta). Como verbo en pasado: `They offered me a deal.` Como sustantivo: `It was a good offer.`"
        }
      ],
      "common_errors_es": [
        "Usar el verbo en presente en lugar del pasado: `I offer a refund` en vez de `I offered a refund`.",
        "Olvidar el cambio de ortografía: `study` → `studied` (no `studyed`).",
        "Usar `did` + verbo en pasado en negaciones: `I didn't offered` en vez de `I didn't offer`.",
        "Confundir `cheap` (barato) con `cheaply` (adverbio)."
      ]
    }
  ],
