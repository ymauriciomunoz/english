      "callouts": [
        {
          "type": "tip",
          "text_md": "**Consejo**: *should* es igual para todas las personas. No digas *he shoulds* — siempre es *he should*."
        },
        {
          "type": "common_error",
          "text_md": "**Error común**: No digas *should to put*. *Should* va seguido del verbo base sin *to*."
        }
      ],
      "common_errors_es": [
        "Decir 'you should to put' en lugar de 'you should put' (no usamos 'to' después de 'should').",
        "Decir 'he shoulds' en lugar de 'he should' (el verbo no cambia con 'he', 'she' o 'it').",
        "Usar 'do' en preguntas: 'Do you should...?' es incorrecto. La forma correcta es 'Should you...?'."
      ]
    }
