      "callouts": [
        {
          "type": "common_error",
          "text_md": "**No digas:** *She have experience.* → **Di:** *She has experience.* Con **he / she / it**, siempre usa **has**."
        },
        {
          "type": "tip",
          "text_md": "**Tip:** Usa `I have experience in + área` para hablar de tu trabajo. Es una frase muy común en entrevistas y CVs."
        },
        {
          "type": "warning",
          "text_md": "**Cuidado:** No traduzcas literalmente *tengo* como *I have got* en contextos formales. En inglés profesional, `I have` es suficiente y más natural."
        }
      ],
      "common_errors_es": [
        "Usar *have* con he/she/it: *She have skills* → correcto: *She has skills*.",
        "Olvidar la -s en *has*: *He have experience* → correcto: *He has experience*.",
        "Agregar *got* innecesariamente: *I have got experience* → en contextos formales, mejor *I have experience*."
      ]
    }
  ],
