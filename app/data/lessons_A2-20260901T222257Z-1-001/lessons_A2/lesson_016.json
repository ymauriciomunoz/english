  "grammar_explanations": [
    {
      "slug": "past simple: negative didn't",
      "title_form": "Pasado simple: negativo con didn't",
      "title_target": "Past simple: negative with didn't",
      "description_md_form": "Para decir que **no** hiciste algo en el pasado, usamos **didn't** (did not) + el **verbo en forma base**. La forma del verbo **no cambia** con ninguna persona.\n\n**Estructura:** Sujeto + **didn't** + verbo base + complemento.\n\n| Persona | Ejemplo |\n|---------|---------|\n| I | I **didn't** appear |\n| You | You **didn't** appear |\n| He/She/It | She **didn't** appear |\n| We | We **didn't** appear |\n| They | They **didn't** appear |\n\n**Importante:** No usamos *didn't* con *was/were*. Para *be* en negativo usamos **wasn't** o **weren't**.\n\n**Ejemplo:** *I didn't feel scared.* = No me sentí asustado.",
      "description_md_target": "To say you **did not** do something in the past, use **didn't** (did not) + the **base form of the verb**. The verb form **does not change** for any person.\n\n**Structure:** Subject + **didn't** + base verb + complement.\n\n**Important:** Do not use *didn't* with *was/were*. For *be* in the negative, use **wasn't** or **weren't**.\n\n**Example:** *I didn't feel scared.*",
      "grammar_structure": "Subject + didn't + base verb + complement",
      "conjugation_table": {
        "name": "past_simple_negative",
        "headers": [
          "Pronombre",
          "Negativo",
          "Ejemplo"
        ],
        "rows": [
          [
            "I",
            "didn't appear",
            "I didn't appear."
          ],
          [
            "You",
            "didn't appear",
            "You didn't appear."
          ],
          [
            "He/She/It",
            "didn't appear",
            "She didn't appear."
          ],
          [
            "We",
            "didn't appear",
            "We didn't appear."
          ],
          [
            "They",
            "didn't appear",
            "They didn't appear."
          ]
        ]
      },
      "examples": [
