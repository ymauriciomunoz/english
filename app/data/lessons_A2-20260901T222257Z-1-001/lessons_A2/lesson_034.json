      "callouts": [
        {
          "type": "common_error",
          "text_md": "**No digas:** *Does it costs...?* — con **does**, el verbo va sin *-s*: *Does it cost...?*"
        },
        {
          "type": "tip",
          "text_md": "**How much does it cost?** es una frase fija. No la cambies a *How much do it cost?* — *it* siempre usa *does*."
        }
      ],
      "common_errors_es": [
        "Usar *do* con *he/she/it*: *Do it cost?* → correcto: *Does it cost?*",
        "Agregar *-s* al verbo después de *does*: *Does it costs?* → correcto: *Does it cost?*",
        "Olvidar el auxiliar: *You pay with cash?* → correcto: *Do you pay with cash?*"
      ]
    }
  ],
