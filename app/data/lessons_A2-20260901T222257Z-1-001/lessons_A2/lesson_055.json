      "callouts": [
        {
          "type": "warning",
          "text_md": "**Cuidado:** No uses *the most* con adjetivos cortos. Decimos *the top* y *the worst*, no *the most top* ni *the most worst*."
        },
        {
          "type": "tip",
          "text_md": "**Tip:** Para adjetivos largos como *excellent* o *possible*, siempre usa *the most* + adjetivo. Es la forma más segura."
        }
      ],
      "common_errors_es": [
        "Decir *the most top* en lugar de *the top*. *Top* es corto, no lleva *most*.",
        "Decir *the most worst* en lugar de *the worst*. *Worst* ya es superlativo.",
        "Olvidar el artículo *the* antes de *most*. Siempre es *the most* + adjetivo."
      ]
    }
