      "callouts": [
        {
          "type": "tip",
          "text_md": "**Recuerda**: el verbo *to be* es el que cambia con la persona. El verbo principal siempre termina en **-ing**. No digas \"I looking\" — siempre necesitas *am/is/are* antes."
        },
        {
          "type": "common_error",
          "text_md": "**Error común**: \"I am look for a product\" ✗. La forma correcta es \"I am **looking** for a product\" ✓. El verbo principal siempre lleva **-ing**."
        }
      ],
      "common_errors_es": [
        "Olvidar el verbo *to be*: \"I looking for a product\" en vez de \"I am looking for a product\".",
        "No añadir -ing al verbo principal: \"She is pick up the shoes\" en vez de \"She is picking up the shoes\".",
        "Usar *is* con *I*: \"I is looking\" en vez de \"I am looking\"."
      ]
    }
  ],
