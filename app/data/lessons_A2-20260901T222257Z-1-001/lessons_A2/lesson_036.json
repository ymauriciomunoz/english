      "callouts": [
        {
          "type": "tip",
          "text_md": "**Recuerda:** `than` es la palabra 'que' en comparaciones. No la confundas con `that` (ese/esa)."
        },
        {
          "type": "common_error",
          "text_md": "**Error común:** Decir *'more low'* en lugar de *'lower'*. Para adjetivos cortos, usa siempre **-er**, no 'more'."
        },
        {
          "type": "warning",
          "text_md": "**Ojo con la ortografía:** `heavy` → `heavier` (cambia la 'y' por 'i'). No escribas *'heavyer'*."
        }
      ],
      "common_errors_es": [
        "Olvidar la palabra 'than': *'This chair is lower that one'* (incorrecto) → *'This chair is lower than that one'* (correcto).",
        "Usar 'more' con adjetivos cortos: *'more low'* (incorrecto) → *'lower'* (correcto).",
        "No cambiar 'y' por 'i' en adjetivos como 'heavy': *'heavyer'* (incorrecto) → *'heavier'* (correcto).",
        "Confundir 'than' con 'that': *'softer that'* (incorrecto) → *'softer than'* (correcto)."
      ]
    }
  ],
