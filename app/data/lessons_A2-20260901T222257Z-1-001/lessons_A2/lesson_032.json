      ],
      "callouts": [
        {
          "type": "tip",
          "text_md": "**Tip:** En español, \"había\" sirve para singular y plural. En inglés, debes elegir **was** (singular) o **were** (plural). Piensa en el sustantivo que sigue."
        },
        {
          "type": "common_error",
          "text_md": "**Error común:** No digas *\"There was two lakes\"*. Como *two lakes* es plural, debes usar **were**: *\"There were two lakes\"*."
        }
      ],
      "common_errors_es": [
        "Usar 'there was' con sustantivos plurales: 'There was two forests' → correcto: 'There were two forests'.",
        "Olvidar la palabra 'there': 'Was a lake' → correcto: 'There was a lake'.",
        "Confundir 'was' y 'were' con 'había': en español no cambia, pero en inglés sí depende del número."
      ]
    }
  ],
