  "grammar_explanations": [
    {
      "slug": "would like: offers and invitations",
      "title_form": "Would like: ofertas e invitaciones",
      "title_target": "Would like: offers and invitations",
      "description_md_form": "**Would like** es una forma cortés de ofrecer algo o invitar a alguien. Es más formal y amable que *Do you want...?*.\n\n**Estructura:**\n- **Would you like + sustantivo?** → *Would you like some tea?*\n- **Would you like + to + verbo?** → *Would you like to come?*\n\n**Respuestas:**\n- **Sí:** *Yes, please.* / *Yes, I would.*\n- **No:** *No, thank you.* / *No, thanks.*\n\n**Contracción:** *I'd like* = *I would like*. En preguntas, *Would you* se pronuncia como *Wouldja* en conversación rápida.\n\n**Uso:**\n- Para **invitar**: *Would you like to come to my party?*\n- Para **ofrecer**: *Would you like some coffee?*\n\nEs una forma fija: *would* no cambia con la persona (I, you, he, she...).",
      "description_md_target": "**Would like** is a polite way to offer something or invite someone. It is more formal and friendly than *Do you want...?*.\n\n**Structure:**\n- **Would you like + noun?** → *Would you like some tea?*\n- **Would you like + to + verb?** → *Would you like to come?*\n\n**Answers:**\n- **Yes:** *Yes, please.* / *Yes, I would.*\n- **No:** *No, thank you.* / *No, thanks.*\n\n**Contraction:** *I'd like* = *I would like*. In questions, *Would you* sounds like *Wouldja* in fast speech.\n\n**Use:**\n- To **invite**: *Would you like to come to my party?*\n- To **offer**: *Would you like some coffee?*\n\nIt is a fixed form: *would* does not change with the person (I, you, he, she...).",
      "grammar_structure": "Would you like + (to) + [noun/verb]?",
      "conjugation_table": {
        "name": "would_like_offers",
        "headers": [
          "Persona",
          "Pregunta",
          "Respuesta sí",
          "Respuesta no"
        ],
        "rows": [
          [
            "I",
            "Would I like...?",
            "Yes, I would.",
            "No, I wouldn't."
          ],
          [
            "You",
            "Would you like...?",
            "Yes, I would.",
            "No, I wouldn't."
          ],
          [
            "He/She",
            "Would he/she like...?",
            "Yes, he/she would.",
            "No, he/she wouldn't."
          ],
          [
            "We",
            "Would we like...?",
            "Yes, we would.",
            "No, we wouldn't."
          ],
          [
            "They",
            "Would they like...?",
            "Yes, they would.",
            "No, they wouldn't."
          ]
        ]
      },
