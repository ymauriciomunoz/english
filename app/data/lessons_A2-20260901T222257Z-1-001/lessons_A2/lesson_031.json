      "callouts": [
        {
          "type": "tip",
          "text_md": "**Recuerda:** `get on` y `get off` son para vehículos grandes (tren, bus, avión). `get in` es para vehículos pequeños (taxi, coche)."
        },
        {
          "type": "common_error",
          "text_md": "**Error común:** No digas `get in the train`. Para trenes y buses, usa siempre `get on`."
        }
      ],
      "common_errors_es": [
        "Decir 'get in the train' en lugar de 'get on the train'.",
        "Olvidar la partícula: 'get the bus' en lugar de 'get on the bus'.",
        "Confundir 'get off' (bajar) con 'get on' (subir)."
      ]
    }
