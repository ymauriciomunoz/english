      "callouts": [
        {
          "type": "tip",
          "text_md": "**Tip:** Después de **How about**, el verbo **siempre** lleva **-ing**. Nunca uses el infinitivo: ✗ *How about play sports?* → ✓ *How about playing sports?*"
        },
        {
          "type": "common_error",
          "text_md": "**Error común:** No digas *How about to play?* El **to** no se usa después de **How about**. Siempre es **How about + -ing**."
        },
        {
          "type": "tip",
          "text_md": "**Tip:** Para responder, puedes decir: *Good idea!* (¡Buena idea!) o *No problem.* (No hay problema). También puedes sugerir otra cosa: *How about baseball?*"
        }
      ],
      "common_errors_es": [
        "Usar el infinitivo después de How about: ✗ How about to play? → ✓ How about playing?",
        "Olvidar el signo de interrogación en inglés: ✗ How about reading → ✓ How about reading?",
        "Traducir literalmente '¿Qué te parece?' como 'What do you think?' en lugar de usar 'How about...?'"
      ]
    }
