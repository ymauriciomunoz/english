  "grammar_explanations": [
    {
      "slug": "going to: affirmative for future plans",
      "title_form": "Going to: afirmativo para planes futuros",
      "title_target": "Going to: affirmative for future plans",
      "description_md_form": "Usamos **going to** para hablar de **planes futuros** que ya tenemos en mente. La estructura es: **sujeto + verbo *to be* + going to + verbo en infinitivo**.\n\n- **I'm going to organize** my project tomorrow.\n- **She's going to decide** the option today.\n\nEl verbo *to be* cambia según el sujeto: *am*, *is*, *are*. Después de *going to*, el verbo principal siempre va en su forma base (sin cambios).\n\nEste patrón es muy común para expresar **intenciones** y **arreglos** que ya hemos pensado. No es una decisión del momento, sino un plan que ya existe en nuestra mente.",
      "description_md_target": "We use **going to** to talk about **future plans** that we already have in mind. The structure is: **subject + verb *to be* + going to + infinitive verb**.\n\n- **I'm going to organize** my project tomorrow.\n- **She's going to decide** the option today.\n\nThe verb *to be* changes according to the subject: *am*, *is*, *are*. After *going to*, the main verb always goes in its base form (no changes).\n\nThis pattern is very common to express **intentions** and **arrangements** that we have already thought about. It is not a decision of the moment, but a plan that already exists in our mind.",
      "grammar_structure": "Subject + to be (am/is/are) + going to + base verb + complement",
      "conjugation_table": {
        "name": "going_to_affirmative",
        "headers": [
          "Pronombre",
          "Forma con going to"
        ],
        "rows": [
          [
            "I",
            "I am going to organize"
          ],
          [
