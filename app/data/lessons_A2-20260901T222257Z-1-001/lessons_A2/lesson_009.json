    {
      "id": "quiz_001",
      "title_form": "Quiz: Talking about yesterday",
      "title_target": "Quiz: Talking about yesterday",
      "questions": [
        {
          "id": "q_001",
          "kind": "listening_comprehension",
          "prompt_form": "Escucha y elige la respuesta correcta: ¿Qué dice la persona sobre su día?",
          "prompt_target": "Listen and choose the correct answer: What does the person say about their day?",
          "options": [
            "The person was busy yesterday.",
            "The person was nervous yesterday.",
            "The person was surprised yesterday.",
            "The person was bored yesterday."
          ],
          "correct_answer": "The person was busy yesterday.",
          "explanation_form": "La persona dice 'Yesterday was a busy day for me', lo que indica que estuvo ocupada.",
          "explanation_target": "The person says 'Yesterday was a busy day for me', which means they were busy.",
          "references_exercise_id": null,
          "references_lesson_topics": [
            "busy",
            "past simple: was/were"
          ],
          "points": 10,
          "difficulty": "easy",
          "passage_md": null,
          "transcript": "Yesterday was a busy day for me. I had a meeting in the morning. After the meeting, I went to the supermarket. I was tired at the end of the day.",
          "sample_answers": [],
          "reading_target": null
        },
        {
          "id": "q_002",
          "kind": "listening_comprehension",
