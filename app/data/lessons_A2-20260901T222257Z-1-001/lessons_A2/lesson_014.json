      "callouts": [
        {
          "type": "warning",
          "text_md": "**¡Cuidado!** Después de **did**, el verbo va en forma base. Nunca digas `Did you served...?` — siempre `Did you serve...?`."
        },
        {
          "type": "tip",
          "text_md": "**Tip:** En preguntas, **anybody** es más común que **somebody**. Usa **anybody** cuando no sabes si alguien hizo algo."
        },
        {
          "type": "common_error",
          "text_md": "**Error común:** No digas `Did you went...?`. El verbo **go** en forma base es **go**, no **went**. Correcto: `Did you go...?`"
        }
      ],
      "common_errors_es": [
        "Usar el verbo en pasado después de did: `Did you served...?` → Correcto: `Did you serve...?`",
        "Olvidar did y usar el verbo en pasado directamente: `You celebrated?` → Correcto: `Did you celebrate?`",
        "Confundir anybody y somebody: en preguntas, anybody es más natural cuando no sabes la respuesta."
      ]
    }
  ],
